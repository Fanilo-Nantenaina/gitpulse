# GitPulse reads these from the environment. Copy to .env (never commit it) or
# set them as system/user variables. Every line is optional.

# --- AI providers (keys can also be pasted in the web UI) -------------------
ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=
# GITPULSE_MODEL=claude-opus-5
OPENAI_API_KEY=
GEMINI_API_KEY=
# OLLAMA_HOST=http://localhost:11434
# GITPULSE_OLLAMA_MODEL=qwen2.5-coder:7b
# GITPULSE_OLLAMA_MAX_CTX=32768

# --- Output -----------------------------------------------------------------
# GITPULSE_LANG=fr

# --- Privacy, cache, storage ------------------------------------------------
# cloud (default) redacts secrets before cloud calls; always also covers Ollama; off disables
# GITPULSE_REDACT=cloud
# off disables the digest cache / history
# GITPULSE_CACHE=on
# GITPULSE_CONFIG_DIR=~/.gitpulse
# GITPULSE_HISTORY_DIR=~/.gitpulse/history
# GITPULSE_CACHE_DIR=~/.gitpulse/remotes

# --- Private remotes ----------------------------------------------------------
# GITPULSE_GIT_TOKEN=
# GITPULSE_GIT_USERNAME=git
# GITPULSE_SSH_KEY=~/.ssh/id_ed25519
# GITPULSE_SSH_PASSPHRASE=

# --- Web UI -----------------------------------------------------------------
# GITPULSE_ALLOWED_HOSTS=gitpulse.lan

# --- Notifiers ----------------------------------------------------------------
# GITPULSE_SLACK_WEBHOOK=https://hooks.slack.com/services/...
# GITPULSE_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
# GITPULSE_TELEGRAM_TOKEN=
# GITPULSE_TELEGRAM_CHAT_ID=
# GITPULSE_SMTP_HOST=smtp.gmail.com
# GITPULSE_SMTP_PORT=587
# GITPULSE_SMTP_USER=
# GITPULSE_SMTP_PASS=
# GITPULSE_SMTP_TO=
# GITPULSE_SMTP_FROM=
