# Packaging / build artifacts
*.egg-info/
build/
dist/
*.egg

# Python caches & test tools
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.pytest_tmp/
.ruff_cache/
.mypy_cache/
.pyright/
.coverage
htmlcov/
coverage.xml
.tox/

# Virtual environments
.venv/
venv/
env/

# Logs & runtime service files
*.log
server.log
*.pid
server.pid

# Secrets — never commit these
.env
.env.*
*.key

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
.idea/
.vscode/
*.swp
*.sublime-workspace
*.sublime-project

# Local code-rewriting scratch scripts, root only.
#
# This was previously the unanchored glob `*comment*`, which also silently
# ignored any real source file whose name contained "comment"
# (gitpulse/web/routes/comments.py, tests/test_comments.py, ...).
# NOTE: clean_comments_v2.py is what deleted three import lines from
# gitpulse/cli/main.py and removed 17 CLI commands. It should be tracked with
# tests or deleted - not hidden.
/clean_comments*.py